{
  "name": "gpt-image-studio",
  "version": "0.2.0",
  "description": "macOS desktop client for GPT image generation",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:mac:dir": "npm run build && electron-builder --mac --arm64 --dir",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "build:cli": "esbuild src/cli/gen.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist-cli/gen.cjs",
    "build:mcp": "esbuild src/mcp/server.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist-cli/mcp.cjs",
    "gen": "node dist-cli/gen.cjs",
    "mcp": "node dist-cli/mcp.cjs"
  },
  "dependencies": {
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.pony.gptimagestudio",
    "productName": "GPT Image",
    "copyright": "Copyright © 2026 pony",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "build/icon.*"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "extendInfo": {
        "NSHighResolutionCapable": true,
        "LSApplicationCategoryType": "public.app-category.graphics-design"
      }
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      },
      "writeUpdateInfo": false
    }
  }
}
